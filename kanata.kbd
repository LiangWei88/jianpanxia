#|
Kanata Vim 风格全局导航键盘系统
---------------------------------
CapsLock: tap → Esc, hold → Nav Layer
右 Alt:   tap → ralt (AltGr), hold → Symbols Layer (左手编程符号)
开发文档: kanata-开发文档.md
Kanata 版本: 1.12.0
后端: Windows winIOv2
启动: kanata_windows_tty_winIOv2_cmd_allowed_x64.exe --cfg kanata.kbd
检查: kanata_windows_tty_winIOv2_cmd_allowed_x64.exe --check --cfg kanata.kbd
紧急退出: Left Ctrl + Space + Esc (物理键，在 Kanata 重映射前生效)
|#

;; ==================== defcfg ====================
(defcfg
  ;; 允许处理未在 defsrc 中定义的键
  process-unmapped-keys yes

  ;; 并发 tap-hold 优化，加快多 tap-hold 决策
  concurrent-tap-hold yes
)

;; ==================== defsrc ====================
;; 标准 US QWERTY 布局，所有物理键都被 Kanata 拦截
(defsrc
  grv  1    2    3    4    5    6    7    8    9    0    -    =    bspc
  tab  q    w    e    r    t    y    u    i    o    p    [    ]    \
  caps a    s    d    f    g    h    j    k    l    ;    '    ret
  lsft z    x    c    v    b    n    m    ,    .    /    rsft
  lctl lmet lalt           spc            ralt rmet rctl
)

;; ==================== defvar ====================
;; 可调参数：CapsLock tap/hold 超时时间（毫秒）
(defvar
  tap-timeout   180   ;; tap 判定超时
  hold-timeout  180   ;; hold 激活超时
)

;; ==================== defalias ====================
;; 注意: alias 定义名不带 @ 前缀，引用时才用 @
(defalias
  ;; --- CapsLock tap/hold ---
  ;; tap → Esc, hold → 激活 Nav Layer (layer-toggle)
  capnav (tap-hold $tap-timeout $hold-timeout esc (layer-toggle nav))

  ;; --- 单词级移动 ---
  word-right C-rght   ;; Ctrl + Right (下一个单词)
  word-left  C-left   ;; Ctrl + Left  (上一个单词)

  ;; --- 浏览器/文件管理器前进后退 ---
  back  A-left        ;; Alt + Left  (后退)
  fwd   A-rght        ;; Alt + Right (前进)

  ;; --- 文档快速跳转 ---
  doc-home C-home     ;; Ctrl + Home (文档开头)
  doc-end  C-end      ;; Ctrl + End  (文档末尾)

  ;; --- G 键条件输出 ---
  ;; 默认 → Ctrl+Home
  ;; Shift 按下时 → 先释放 Shift 再 Ctrl+End（避免选中效果）
  g-home-end (fork @doc-home (multi (release-key lsft) (release-key rsft) @doc-end) (lsft rsft))

  ;; --- 鼠标滚轮（带惯性加速）---
  ;; 参数: initial-velocity max-velocity acceleration deceleration
  wheel-up   (mwheel-accel-up   3 1200 1.15 0.93)
  wheel-down (mwheel-accel-down 3 1200 1.15 0.93)

  ;; --- V2 NavLock ---
  ;; R 键 toggle 导航层锁定：在 Nav 活跃时按 R 进入 NavLock，
  ;; 在 NavLock 状态下按 R 切回 base
  navlock-in  (layer-switch navlock)
  navlock-out (layer-switch base)

  ;; --- V3 Symbols Layer ---
  ;; 右 Alt tap/hold: tap→ralt (AltGr 原行为), hold→Symbols Layer
  symalt (tap-hold $tap-timeout $hold-timeout ralt (layer-toggle symbols))
)

;; ==================== deflayer base ====================
;; Base Layer: 除 CapsLock 外，所有键保持原始行为
(deflayer base
  _    1    2    3    4    5    6    7    8    9    0    -    =    bspc
  tab  q    w    e    r    t    y    u    i    o    p    [    ]    \
  @capnav a    s    d    f    g    h    j    k    l    ;    '    ret
  lsft z    x    c    v    b    n    m    ,    .    /    rsft
  lctl lmet lalt           spc            @symalt rmet rctl
)

;; ==================== deflayer nav ====================
;; Nav Layer: CapsLock 按住时激活
;; 所有未定义的键透明传递（保持 base layer 行为）
(deflayer nav
  _    _    _    _    _    _    _    _    _    _    _    _    _    _
  _    _    @word-right _    @navlock-in _    home pgup pgdn end  _    _    _    _
  _    _    _    _    _    @g-home-end left down up rght @back @fwd _
  _    _    del  caps _    @word-left _    @wheel-down @wheel-up _    _    _
  _    _    _              _              _    _    _
)

;; ==================== deflayer navlock ====================
;; NavLock 层：Nav Layer 的永久锁定版
;; 与 nav 层映射完全相同，但：
;;   - CapsLock 恢复 tap-hold 行为（tap→Esc, hold→nav layer）
;;   - R 键切换回 base（退出 NavLock）
;; 进入方式：CapsLock hold → nav 层 → 按 R
;; 退出方式：在 navlock 层按 R
(deflayer navlock
  _    _    _    _    _    _    _    _    _    _    _    _    _    _
  _    _    @word-right _    @navlock-out _    home pgup pgdn end  _    _    _    _
  @capnav _    _    _    _    @g-home-end left down up rght @back @fwd _
  _    _    del  caps _    @word-left _    @wheel-down @wheel-up _    _    _
  _    _    _              _              @symalt _    _
)

;; ==================== deflayer symbols ====================
;; V3 Symbols Layer: 右 Alt 按住时激活
;; 左手映射高频编程符号，右手全部透明
;;
;; 设计逻辑: 右手按 Alt 做修饰，左手腾出来按符号 —— 和 Shift/修饰键双手配合一致
;;
;; 键位设计 (ANSI QWERTY 左手):
;;   左手中指 (e, d, c) → 左括号 ( [ {
;;   左手食指 (r, f, v) → 右括号 ) ] }
;;   左手食指扩展 (t, g, b) → 运算符 / \ =
;;
;;   row 2 (上行):     e=(    r=)    t=/
;;   row 3 (home row): d=[    f=]    g=\
;;   row 4 (下行):     c={    v=}    b==
;;
;; chord 格式: S-9=Shift+9 即 (   S-0=Shift+0 即 )
;;             S-[=Shift+[ 即 {   S-]=Shift+] 即 }
;;             (){} 是 S-expression 特殊字符，必须用 chord 格式
;;
;; 退出方式: 松开右 Alt (layer-toggle 自动关闭)
(deflayer symbols
  ;; defsrc anchor:
  ;; row0: grv 1 2 3 4 5 6 7 8 9 0 - = bspc
  ;; row1: tab q w e r t y u i o p [ ] \
  ;; row2: caps a s d f g h j k l ; ' ret
  ;; row3: lsft z x c v b n m , . / rsft
  ;; row4: lctl lmet lalt spc ralt rmet rctl
  _    _    _    _    _    _    _    _    _    _    _    _    _    _
  _    _    _    S-9  S-0  /    _    _    _    _    _    _    _    _
  _    _    _    [    ]    \    _    _    _    _    _    _    _
  _    _    _    S-[  S-]  _    _    _    _    _    _    _
  _    _    _              _              _    _    _
)
